@using DmxControlUtilities.Lib.Models
@using DmxControlUtilities.Lib.Services
@using DmxControlUtilities.Lib.Services.Hal
@using MComponents.MForm
@using MComponents.MGrid
@using MComponents.MSelect

@inject CuelistService CuelistService
@inject DeviceService DeviceService
@inject ProgrammerService ProgrammerService

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Edit cue</h5>

        @if (mError != null)
        {
            <div class="alert alert-danger" role="alert">@mError</div>
        }

        <MForm T="Cue" Model="mCue" @key="mCue" @ref="mForm" OnValidSubmit="Save">
            <Fields>
                <MField Property="@nameof(Cue.Name)" />
                <MField Property="@nameof(Cue.Comment)" />
                <MFieldRow>
                    <MField Property="@nameof(Cue.Trigger)" />
                    <MField Property="@nameof(Cue.TriggerMilliseconds)" min="0" />
                </MFieldRow>
                <MFieldRow>
                    <MField Property="@nameof(Cue.DelayMilliseconds)" min="0" />
                    <MField Property="@nameof(Cue.FadeMilliseconds)" min="0" />
                </MFieldRow>
            </Fields>
        </MForm>

        <p class="small text-muted">
            Manual waits for Go. Follow waits for the preceding cue's delay and fade to finish,
            then counts the trigger time. Wait counts from the preceding cue's trigger.
            All times are in milliseconds; Manual ignores trigger time.
        </p>

        <div class="mb-3">
            <label class="form-label">Capture source</label>
            <div class="d-flex flex-wrap gap-2 mb-2">
                <button type="button" class="btn btn-outline-success btn-sm" @onclick="CaptureFromProgrammer"
                        disabled="@(!ProgrammerService.HasValues)">
                    Store values from Programmer (@ProgrammerCount values)
                </button>
            </div>
            <label class="form-label">Devices to capture from device controls</label>
            <MSelect T="Device" Options="mDevices" @bind-Values="mSelectedDevices"
                     Property="@nameof(Device.Name)" EnableSearch="true" EnableSelectAll="true" />
            <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="Capture"
                    disabled="@(mSelectedDevices.Count == 0)">Replace captured values from device controls</button>
            <p class="small text-muted mt-1">
                Use "Store values from Programmer" for staged values, or capture directly from device controls.
            </p>
        </div>

        <h6>Captured values (@mValues.Count)</h6>
        @if (mValues.Count == 0)
        {
            <p class="text-muted">No values captured. An empty cue changes timing only.</p>
        }
        else
        {
            <MGrid T="CueValueRow" DataSource="mValues" EnableAdding="false" EnableEditing="false" EnableDeleting="false"
                   EnableFilterRow="false" EnableGrouping="false" EnableExport="false" EnableImport="false" EnableSaveState="false">
                <MGridColumn Property="@nameof(CueValueRow.DeviceName)" HeaderText="Device" PropertyType="typeof(string)" />
                <MGridColumn Property="@nameof(CueValueRow.FeatureName)" HeaderText="Feature" PropertyType="typeof(string)" />
                <MGridComplexColumn T="CueValueRow" Identifier="Value" HeaderText="Value">
                    <CellTemplate Context="value">
                        <input type="text"
                               class="form-control form-control-sm @(value.IsValid ? "" : "is-invalid")"
                               aria-label="@($"{value.DeviceName}: {value.FeatureName}")"
                               @bind="value.Text" @bind:event="oninput" />
                        @if (!value.IsValid)
                        {
                            <span class="invalid-feedback">@value.FormatHint</span>
                        }
                    </CellTemplate>
                </MGridComplexColumn>
            </MGrid>
        }

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-primary" @onclick="Submit" disabled="@mValues.Any(v => !v.IsValid)">Save cue</button>
            <button type="button" class="btn btn-secondary" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Cue Model { get; set; } = null!;

    [Parameter]
    public EventCallback<Cue> OnSave { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private Cue? mSource;
    private Cue mCue = new();
    private MForm<Cue>? mForm;
    private IReadOnlyList<Device> mDevices = Array.Empty<Device>();
    private ICollection<Device> mSelectedDevices = new List<Device>();
    private List<CueValueRow> mValues = new();
    private string? mError;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(mSource, Model))
            return;

        mSource = Model;
        mCue = Model.Clone();
        mDevices = DeviceService.Devices;
        mSelectedDevices = mDevices.Where(d => mCue.DeviceValues.Count == 0 || mCue.DeviceValues.ContainsKey(d.Id)).ToList();
        mError = null;
        RefreshValues();
    }

    private int ProgrammerCount => ProgrammerService.ValueCount;

    private void CaptureFromProgrammer()
    {
        var values = ProgrammerService.CreateCueValues();
        if (values.Count > 0)
        {
            mCue.DeviceValues = values;
            mError = null;
            RefreshValues();
        }
    }

    private void Capture()
    {
        try
        {
            mCue.DeviceValues = CuelistService.CaptureCue(mSelectedDevices.Select(d => d.Id), mCue.Name).DeviceValues;
            mError = null;
            RefreshValues();
        }
        catch (InvalidOperationException ex)
        {
            mError = ex.Message;
        }
    }

    private void RefreshValues()
    {
        mValues = new List<CueValueRow>();

        foreach (var captured in mCue.DeviceValues)
        {
            var device = DeviceService.GetDevice(captured.Key);

            foreach (var value in captured.Value)
            {
                mValues.Add(new CueValueRow
                {
                    DeviceId = captured.Key,
                    DeviceName = device?.Name ?? $"Missing device ({captured.Key})",
                    Feature = value.Key,
                    FeatureName = value.Value.Name,
                    Kind = value.Value.Kind,
                    Text = ToText(value.Value)
                });
            }
        }
    }

    private static string ToText(CueFeatureValue pValue)
    {
        return pValue switch
        {
            ColorCueValue color => $"#{color.R:x2}{color.G:x2}{color.B:x2}",
            PositionCueValue position => $"{Percent(position.Pan)}, {Percent(position.Tilt)}",
            ScalarCueValue scalar => Percent(scalar.Value).ToString(),
            _ => pValue.ToDisplayString(),
        };
    }

    private static int Percent(double pValue) => (int)Math.Round(Math.Clamp(pValue, 0, 1) * 100);

    private async Task Submit()
    {
        if (mForm != null)
            await mForm.CallLocalSubmit(true);
    }

    private async Task Save()
    {
        if (mValues.Any(v => !v.IsValid))
        {
            mError = "All captured values must match their format (see hints).";
            return;
        }

        foreach (var value in mValues)
        {
            var current = mCue.DeviceValues[value.DeviceId][value.Feature];
            mCue.DeviceValues[value.DeviceId][value.Feature] = value.Parse(current);
        }

        await OnSave.InvokeAsync(mCue.Clone());
    }

    private sealed class CueValueRow
    {
        public Guid DeviceId { get; set; }
        public string DeviceName { get; set; } = string.Empty;
        public string Feature { get; set; } = string.Empty;
        public string FeatureName { get; set; } = string.Empty;
        public CueFeatureValueKind Kind { get; set; }
        public string Text { get; set; } = string.Empty;

        public bool IsValid => TryParse(out _);

        public string FormatHint => Kind switch
        {
            CueFeatureValueKind.Color => "Enter a color as #rrggbb.",
            CueFeatureValueKind.Position => "Enter pan and tilt as percent, e.g. '50, 75'.",
            _ => "Enter a percentage from 0 to 100.",
        };

        public CueFeatureValue Parse(CueFeatureValue pTemplate)
        {
            switch (pTemplate)
            {
                case ColorCueValue color when HalColor.FromHex(Text) is { } rgb:
                    return new ColorCueValue { Feature = color.Feature, Name = color.Name, R = rgb.R, G = rgb.G, B = rgb.B };

                case PositionCueValue position:
                {
                    var parts = Text.Split(',', StringSplitOptions.TrimEntries);
                    if (parts.Length == 2
                        && int.TryParse(parts[0], out int pan) && pan is >= 0 and <= 100
                        && int.TryParse(parts[1], out int tilt) && tilt is >= 0 and <= 100)
                    {
                        return new PositionCueValue { Feature = position.Feature, Name = position.Name, Pan = pan / 100.0, Tilt = tilt / 100.0 };
                    }
                    return position;
                }

                case ScalarCueValue scalar
                    when int.TryParse(Text, out int percent) && percent is >= 0 and <= 100:
                    return new ScalarCueValue { Feature = scalar.Feature, Name = scalar.Name, IsDiscrete = scalar.IsDiscrete, Value = percent / 100.0 };

                default:
                    return pTemplate;
            }
        }

        private bool TryParse(out CueFeatureValue? pValue)
        {
            pValue = null;

            switch (Kind)
            {
                case CueFeatureValueKind.Color:
                    return HalColor.FromHex(Text) != null;

                case CueFeatureValueKind.Position:
                {
                    var parts = Text.Split(',', StringSplitOptions.TrimEntries);
                    return parts.Length == 2
                        && int.TryParse(parts[0], out int pan) && pan is >= 0 and <= 100
                        && int.TryParse(parts[1], out int tilt) && tilt is >= 0 and <= 100;
                }

                default:
                    return int.TryParse(Text, out int percent) && percent is >= 0 and <= 100;
            }
        }
    }
}
