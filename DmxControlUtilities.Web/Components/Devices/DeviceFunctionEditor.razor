@using DmxControlUtilities.Lib.Models
@using DmxControlUtilities.Lib.Models.Ddf
@using DmxControlUtilities.Lib.Services.Hal

@inject HalService Hal

<div class="mb-2">
    <label class="form-label">@Function.Name: @Value@(CurrentStepCaption != null ? $" ({CurrentStepCaption})" : "")</label>

    <div style="display: flex; gap: 0.5rem; align-items: center;">
        <input type="range" min="0" max="255" step="1" class="form-range" style="flex: 1 1 auto;"
               value="@Value" @oninput="OnValueInput" />

        <input type="number" min="0" max="255" class="form-control form-control-sm" style="width: 5rem;"
               value="@Value" @onchange="OnValueInput" />

        @if (Function.Steps.Count > 0)
        {
            <select class="form-select form-select-sm" style="width: auto;" value="@Value" @onchange="OnStepSelected">
                @foreach (var step in Function.Steps)
                {
                    <option value="@step.MinDmx" selected="@(Value >= step.MinDmx && Value <= step.MaxDmx)">
                        @step.Caption (@step.MinDmx - @step.MaxDmx)
                    </option>
                }
            </select>
        }
    </div>
</div>

@code {

    [Parameter]
    public Device Device { get; set; } = null!;

    [Parameter]
    public DdfFunction Function { get; set; } = null!;

    [Parameter]
    public EventCallback OnValueChanged { get; set; }

    private byte Value => Device.GetValue(Function.Key);

    private string? CurrentStepCaption
    {
        get
        {
            var step = Function.Steps.FirstOrDefault(s => Value >= s.MinDmx && Value <= s.MaxDmx);
            return string.IsNullOrWhiteSpace(step?.Caption) ? null : step.Caption;
        }
    }

    private void OnValueInput(ChangeEventArgs pArgs)
    {
        if (byte.TryParse(pArgs.Value?.ToString(), out byte value))
        {
            SetValue(value);
        }
    }

    private void OnStepSelected(ChangeEventArgs pArgs)
    {
        if (byte.TryParse(pArgs.Value?.ToString(), out byte value))
        {
            SetValue(value);
        }
    }

    private void SetValue(byte pValue)
    {
        Hal.SetValue(Device, Function.Key, pValue);
        OnValueChanged.InvokeAsync();
    }
}
