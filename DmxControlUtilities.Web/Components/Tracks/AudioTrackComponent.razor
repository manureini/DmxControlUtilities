@using DmxControlUtilities.Lib.Models
@inject IJSRuntime JSRuntime
@implements IDisposable

<div style="margin-top: 1rem;">

    <div style="width: 88vw; box-sizing: border-box; overflow: hidden; border: 1px solid #ccc; border-radius: 6px; padding: 1rem; background-color: #fff;">
         
        <div style="margin: 0.25rem 0; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            @for (int i = 0; i < Track.AudioFiles.Count; i++)
            {
                var index = i;
                var file = Track.AudioFiles[index];

                <span style="display: inline-flex; gap: 0.25rem; align-items: center; border: 1px solid @(SelectedFileId == file.Id ? "#0d6efd" : "#ccc"); border-radius: 4px; padding: 0.1rem 0.4rem; cursor: pointer; background-color: @(SelectedFileId == file.Id ? "#cfe2ff" : "#f8f8f8");"
                      @onclick="() => SelectFile(file)">
                    <span>@file.FileName (@FormatTime(file.StartOffset))</span>
                    <button class="btn btn-secondary btn-sm" style="padding: 0 0.3rem;" disabled="@(index == 0)" @onclick="() => OnMoveFile.InvokeAsync((file.Id, -1))" @onclick:stopPropagation="true" title="Move up">&uarr;</button>
                    <button class="btn btn-secondary btn-sm" style="padding: 0 0.3rem;" disabled="@(index == Track.AudioFiles.Count - 1)" @onclick="() => OnMoveFile.InvokeAsync((file.Id, 1))" @onclick:stopPropagation="true" title="Move down">&darr;</button>
                    <button class="btn btn-danger btn-sm" style="padding: 0 0.3rem;" @onclick="() => OnRemoveFile.InvokeAsync(file.Id)" @onclick:stopPropagation="true" title="Remove file">x</button>
                </span>
            }
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start; width: 100%;">
            <div style="flex: 0 0 220px; border: 1px solid #ccc; border-radius: 6px; padding: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.25rem;">
                    <strong style="margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@Track.Name">@Track.Name</strong>
                    <span style="display: inline-flex; gap: 0.25rem; align-items: center; flex-shrink: 0;">
                        <button type="button" class="btn btn-sm @(Track.Muted ? "btn-secondary" : "btn-outline-secondary")" style="padding: 0 0.4rem; line-height: 1.2;"
                                title="@(Track.Muted ? "Unmute track" : "Mute track")" @onclick="ToggleMute">
                            @if (Track.Muted)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.1em;">
                                    <path d="M6.717 3.55A.5.5 0 0 1 7 3.55v8.9a.5.5 0 0 1-.812.39L3.825 10.5H1.5A.5.5 0 0 1 1 10V6a.5.5 0 0 1 .5-.5h2.325l2.363-1.89a.5.5 0 0 1 .529-.06zM8 5.04 6.056 3.59 7.5 2.146 9.444 3.59l1.944-1.444 1.444 1.444-1.944 1.444 1.944 1.444-1.444 1.444-1.944-1.444L7.5 8.922 6.056 7.478 8 6.034z" transform="translate(0 1) scale(0.9)" />
                                </svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.1em;">
                                    <path d="M11.536 14.01A8.473 8.473 0 0 0 14.026 8a8.473 8.473 0 0 0-2.49-6.01l-.708.707A7.476 7.476 0 0 1 13.025 8c0 2.071-.84 3.946-2.197 5.303l.708.707z" />
                                    <path d="M10.121 12.596A6.48 6.48 0 0 0 12.025 8a6.48 6.48 0 0 0-1.904-4.596l-.707.707A5.483 5.483 0 0 1 11.025 8a5.483 5.483 0 0 1-1.61 3.89l.706.706z" />
                                    <path d="M10.025 8a4.486 4.486 0 0 1-1.318 3.182L8 10.475A3.489 3.489 0 0 0 9.025 8c0-.966-.392-1.841-1.025-2.475l.707-.707A4.486 4.486 0 0 1 10.025 8zM7 4.25v7.5L3.5 10.5H1.5a.5.5 0 0 1-.5-.5V6a.5.5 0 0 1 .5-.5h2.325L7 4.25z" />
                                </svg>
                            }
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm" style="padding: 0 0.4rem;" title="Add audio file" @onclick="ShowAddFileModal">+</button>
                        <button type="button" class="btn btn-danger btn-sm" style="padding: 0 0.4rem;" title="Remove audio track" @onclick="OnRemove">x</button>
                    </span>
                </div>

                <label style="display: block; margin-top: 0.5rem;">Threshold: @Track.Threshold.ToString("0.00")</label>
                <input type="range" min="0" max="0.9" step="0.01" style="width: 100%;"
                       value="@Track.Threshold.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="e => OnSettingChanged(e, v => Track.Threshold = v)" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>0</span><span>0.9</span></div>

                <label style="display: block; margin-top: 0.5rem;">Ratio: @Track.Ratio.ToString("0.00")</label>
                <input type="range" min="0.25" max="4" step="0.05" style="width: 100%;"
                       value="@Track.Ratio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="e => OnSettingChanged(e, v => Track.Ratio = v)" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>0.25</span><span>4</span></div>

                <label style="display: block; margin-top: 0.5rem;">Bandwidth: @Track.Bandwidth.ToString("0.00")</label>
                <input type="range" min="1" max="3" step="0.05" style="width: 100%;"
                       value="@Track.Bandwidth.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                       @oninput="e => OnSettingChanged(e, v => Track.Bandwidth = v)" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>1</span><span>3</span></div>
            </div>

            <div style="flex: 1 1 0; min-width: 0; max-width: 100%; overflow: hidden;">
                <div @ref="_scrollContainer" style="overflow-x: auto; overflow-y: hidden; border: 1px solid #ccc; border-radius: 6px; padding: 8px; background-color: #fff;">
                    <TimeScale Duration="Display.Duration" Width="Display.DisplayWidth" />
                    <div style="position: relative; width: @(Display.DisplayWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; height: 512px; cursor: crosshair; user-select: none;"
                         @onmousedown="OnCursorMouseDown"
                         @onmousemove="OnCursorMouseMove"
                         @onmouseup="OnCursorMouseUp"
                         @onmouseleave="OnCursorMouseUp"
                         @onwheel="OnWheel"
                         @onwheel:preventDefault="true">
                        @for (int i = 0; i < Track.AudioFiles.Count && i < State.ImageDataUrls.Count; i++)
                        {
                            var file = Track.AudioFiles[i];
                            var imageDataUrl = State.ImageDataUrls[i];

                            if (imageDataUrl == null)
                                continue;

                            <img src="@imageDataUrl"
                                 title="@file.FileName (@FormatTime(file.StartOffset)) - hold Shift and drag to move"
                                 style="position: absolute; top: 0; height: 512px; left: @(SegmentX(file).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; width: @(SegmentWidth(file).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; display: block; pointer-events: none;"
                                 draggable="false"
                                 alt="Spectrogram @file.FileName" />
                        }
                        <div style="position: absolute; top: 0; bottom: 0; left: @(CursorX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; width: 2px; background-color: red; pointer-events: none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public TimecodeAudioTrack Track { get; set; } = null!;

    [Parameter]
    public AudioTrackState State { get; set; } = null!;

    /// <summary>
    /// Shared display state (zoom, duration) so all tracks align in a grid.
    /// </summary>
    [Parameter]
    public TrackDisplayState Display { get; set; } = null!;

    [Parameter]
    public TimeSpan Position { get; set; }

    [Parameter]
    public EventCallback OnSettingsChanged { get; set; }

    [Parameter]
    public EventCallback<CursorDragArgs> OnCursorDrag { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>
    /// Raised when the user picks an audio file to add to this track.
    /// </summary>
    [Parameter]
    public EventCallback<AddAudioFileModal.AudioFileResult> OnAddFile { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRemoveFile { get; set; }

    [Parameter]
    public EventCallback<(Guid FileId, int Direction)> OnMoveFile { get; set; }

    /// <summary>
    /// The currently selected audio file (highlighted in the file list).
    /// </summary>
    [Parameter]
    public Guid SelectedFileId { get; set; }

    [Parameter]
    public EventCallback<Guid> SelectedFileIdChanged { get; set; }

    /// <summary>
    /// Raised while a file is dragged on the time axis. The time is the new start offset of the file.
    /// </summary>
    [Parameter]
    public EventCallback<FileDragArgs> OnFileDrag { get; set; }

    /// <summary>
    /// Raised when the muted state of the track is toggled.
    /// </summary>
    [Parameter]
    public EventCallback OnMuteChanged { get; set; }

    [CascadingParameter]
    public IModalService Modal { get; set; } = null!;

    private void ShowAddFileModal()
    {
        var parameters = new ModalParameters
        {
            { nameof(AddAudioFileModal.OnFileSelected), OnAddFile }
        };

        Modal.Show<AddAudioFileModal>("Add audio file", parameters);
    }

    private bool _isDraggingCursor;
    private TimecodeAudioFile? mDraggingFile;
    private double mDraggingFileGrabOffsetX;
    private bool mMoved;

    private ElementReference _scrollContainer;

    /// <summary>
    /// Identifies the scroll-sync group this track belongs to (the show). Set once by the page.
    /// </summary>
    [Parameter]
    public string ScrollGroup { get; set; } = "show";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JSRuntime.InvokeVoidAsync("registerTrackScroll", ScrollGroup, _scrollContainer);
    }

    public void Dispose()
    {
        _ = JSRuntime.InvokeVoidAsync("unregisterTrackScroll", ScrollGroup, _scrollContainer);
    }

    private void ToggleMute()
    {
        Track.Muted = !Track.Muted;
        OnMuteChanged.InvokeAsync();
    }

    private void SelectFile(TimecodeAudioFile pFile)
    {
        SelectedFileId = pFile.Id;
        SelectedFileIdChanged.InvokeAsync(pFile.Id);
    }

    private double CursorX => Display.Duration > TimeSpan.Zero
        ? Position.TotalSeconds / Display.Duration.TotalSeconds * Display.DisplayWidth
        : 0;

    private double SegmentX(TimecodeAudioFile pFile) => pFile.StartOffset.TotalSeconds * Display.PixelsPerSecond;

    private double SegmentWidth(TimecodeAudioFile pFile)
    {
        return Math.Max(0, FileDuration(pFile).TotalSeconds * Display.PixelsPerSecond);
    }

    private TimeSpan FileDuration(TimecodeAudioFile pFile)
    {
        int index = Track.AudioFiles.IndexOf(pFile);

        return index >= 0 && index < State.FileDurations.Count
            ? State.FileDurations[index]
            : TimeSpan.Zero;
    }

    /// <summary>
    /// Returns the audio file whose segment contains the given x position, or null.
    /// </summary>
    private TimecodeAudioFile? HitTestFile(double pOffsetX)
    {
        for (int i = Track.AudioFiles.Count - 1; i >= 0; i--)
        {
            var file = Track.AudioFiles[i];
            double x = SegmentX(file);
            double width = SegmentWidth(file);

            if (pOffsetX >= x && pOffsetX <= x + width)
                return file;
        }

        return null;
    }

    private async void OnWheel(WheelEventArgs pArgs)
    {
        // Shift or Ctrl + wheel scrolls horizontally instead of zooming.
        if (pArgs.ShiftKey || pArgs.CtrlKey)
        {
            await JSRuntime.InvokeVoidAsync("scrollTrackBy", _scrollContainer, pArgs.DeltaY);
            return;
        }

        if (Display.BaseWidth <= 0)
            return;

        double factor = pArgs.DeltaY < 0 ? 1.2 : 1 / 1.2;

        Display.Zoom = Display.Zoom * factor;
    }

    private void OnSettingChanged(ChangeEventArgs pArgs, Action<double> pApply)
    {
        if (double.TryParse(pArgs.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double value))
        {
            pApply(value);
            OnSettingsChanged.InvokeAsync();
        }
    }

    private void OnCursorMouseDown(MouseEventArgs pArgs)
    {
        mMoved = false;

        var hitFile = HitTestFile(pArgs.OffsetX);

        if (hitFile != null)
            SelectFile(hitFile);

        if (pArgs.ShiftKey)
        {
            if (hitFile != null)
            {
                mDraggingFile = hitFile;
                mDraggingFileGrabOffsetX = pArgs.OffsetX;
            }

            return;
        }

        _isDraggingCursor = true;
        OnCursorDrag.InvokeAsync(new CursorDragArgs(pArgs.OffsetX, false));
    }

    private void OnCursorMouseMove(MouseEventArgs pArgs)
    {
        if (mDraggingFile != null)
        {
            mMoved = true;

            double newSegmentLeft = SegmentX(mDraggingFile) + (pArgs.OffsetX - mDraggingFileGrabOffsetX);
            mDraggingFileGrabOffsetX = pArgs.OffsetX;

            OnFileDrag.InvokeAsync(new FileDragArgs(mDraggingFile.Id, PositionFromOffset(newSegmentLeft), false));
            return;
        }

        if (!_isDraggingCursor)
            return;

        OnCursorDrag.InvokeAsync(new CursorDragArgs(pArgs.OffsetX, false));
    }

    private void OnCursorMouseUp(MouseEventArgs pArgs)
    {
        if (mDraggingFile != null)
        {
            var file = mDraggingFile;
            mDraggingFile = null;

            double newSegmentLeft = SegmentX(file) + (pArgs.OffsetX - mDraggingFileGrabOffsetX);
            OnFileDrag.InvokeAsync(new FileDragArgs(file.Id, PositionFromOffset(newSegmentLeft), true));
            return;
        }

        if (!_isDraggingCursor)
            return;

        _isDraggingCursor = false;
        OnCursorDrag.InvokeAsync(new CursorDragArgs(pArgs.OffsetX, true));
    }

    private TimeSpan PositionFromOffset(double pOffsetX)
    {
        if (Display.DisplayWidth <= 0 || Display.Duration <= TimeSpan.Zero)
            return TimeSpan.Zero;

        double fraction = Math.Clamp(pOffsetX / Display.DisplayWidth, 0, 1);
        return TimeSpan.FromSeconds(fraction * Display.Duration.TotalSeconds);
    }

    public record CursorDragArgs(double OffsetX, bool IsFinished);

    public record FileDragArgs(Guid FileId, TimeSpan NewStartOffset, bool IsFinished);

    public static string FormatTime(TimeSpan pTime)
    {
        return pTime.ToString(@"mm\:ss\.f");
    }
}
