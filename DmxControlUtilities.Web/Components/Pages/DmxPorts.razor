@page "/dmxports"

@using DmxControlUtilities.Lib.Services
@using MComponents.MGrid

@inject DmxFtdiService DmxService

<PageTitle>DMX Ports</PageTitle>

<h3>DMX Ports</h3>

<p>
    Current port: <b>@(string.IsNullOrEmpty(mSelectedPort) ? "-" : mSelectedPort)</b>
    (@(DmxService.IsOpen ? "connected" : "not connected"))
</p>

@if (!string.IsNullOrEmpty(mError))
{
    <div class="alert alert-danger">@mError</div>
}

<MGrid T="SerialPortInfo" DataSource="mPorts" EnableAdding="false" EnableEditing="false" EnableDeleting="false" EnableFilterRow="false" EnableGrouping="false" EnableExport="false" EnableImport="false" EnableSaveState="false">
    <MGridColumn Property="@nameof(SerialPortInfo.Name)" HeaderText="Port" PropertyType="typeof(string)" />
    <MGridColumn Property="@nameof(SerialPortInfo.Description)" HeaderText="Description" PropertyType="typeof(string)" />
    <MGridColumn Property="@nameof(SerialPortInfo.SerialNumber)" HeaderText="Serial" PropertyType="typeof(string)" />
    <MGridColumn Property="@nameof(SerialPortInfo.DeviceId)" HeaderText="PNP Device ID" PropertyType="typeof(string)" />

    <MGridComplexColumn T="SerialPortInfo" Identifier="Select" HeaderText="">
        <CellTemplate Context="port">
            <button class="btn btn-primary btn-sm" @onclick="() => SelectPort(port)">Select</button>
        </CellTemplate>
    </MGridComplexColumn>
</MGrid>

<button class="btn btn-secondary mt-2" @onclick="Refresh">Refresh</button>

@code {

    protected List<SerialPortInfo> mPorts = new();
    protected string? mSelectedPort;
    protected string? mError;

    protected override void OnInitialized()
    {
        Refresh();
    }

    protected void Refresh()
    {
        mPorts = SerialPortEnumerator.GetPorts().ToList();
    }

    protected void SelectPort(SerialPortInfo pPort)
    {
        mError = null;

        try
        {
            DmxService.Open(pPort.Name);
            mSelectedPort = pPort.Name;
        }
        catch (Exception e)
        {
            mError = e.Message;
            mSelectedPort = null;
        }
    }
}
