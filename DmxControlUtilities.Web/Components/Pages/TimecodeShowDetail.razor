@page "/shows/{Id:guid}"

@implements IDisposable

@inject AudioSpectrogramService SpectrogramService
@inject AudioPlaybackService PlaybackService
@inject DmxControlUtilities.Lib.Services.DeviceService DeviceService
@inject DmxControlUtilities.Lib.Services.LightTrackService LightTrackService
@inject DmxControlUtilities.Lib.Services.TimecodeShowService ShowService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@using DmxControlUtilities.Lib.Models
@using DmxControlUtilities.Web.Components.Tracks
@using ShowModel = DmxControlUtilities.Lib.Models.TimecodeShow

<PageTitle>Timecode Show</PageTitle>

@if (_show == null)
{
    <p>Show not found.</p>
}
else
{
    <h3>Timecode Show</h3>

    <div class="mb-2" style="display: flex; gap: 0.5rem; align-items: center;">
        <button class="btn btn-secondary btn-sm" @onclick="@(() => NavigationManager.NavigateTo("shows"))">Back</button>
        <input class="form-control" style="width: auto;" @bind="_show.Name" />
    </div>

    <div class="mb-2" style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
        <InputFile OnChange="OnFileSelected" accept=".mp3,.wav,audio/*" />
        <button class="btn btn-secondary btn-sm" @onclick="AddAudioTrack" title="Add sound track">+ Add sound track</button>
        <button class="btn btn-secondary btn-sm" @onclick="AddLightTrack" title="Add light track">+ Add light track</button>
    </div>

    @if (_errorMessage != null)
    {
        <p style="color: red;">@_errorMessage</p>
    }

    @foreach (var audioTrack in _show.AudioTracks)
    {
        var track = audioTrack;
        var state = GetState(track.Id);

        @if (track.AudioFiles.Count > 0)
        {
            <AudioTrackComponent Track="track"
                                 State="state"
                                 Position="GetPosition(track.Id)"
                                 IsPlaying="_isPlaying && _playbackTrackId == track.Id"
                                 OnPlayPause="() => OnPlayPause(track)"
                                 OnStop="() => OnStop(track)"
                                 OnSettingsChanged="() => RegenerateImages(track)"
                                 OnZoom="_ => RegenerateZoomImages(track)"
                                 OnCursorDrag="args => OnCursorDrag(track, args)"
                                 OnFileDrag="args => OnFileDrag(track, args)"
                                 @bind-SelectedFileId="_selectedAudioFileId"
                                 OnRemove="() => RemoveTrack(track)"
                                 OnRemoveFile="fileId => RemoveAudioFile(track, fileId)"
                                 OnMoveFile="args => MoveAudioFile(track, args.FileId, args.Direction)" />
        }
        else
        {
            <div style="margin-top: 1rem; display: flex; gap: 0.5rem; align-items: center;">
                <strong>@(string.IsNullOrEmpty(track.Name) ? "Empty audio track" : track.Name)</strong>
                <span style="color: #888; font-size: 0.9rem;">No audio files. Use the file picker above to add audio.</span>
                <button class="btn btn-danger btn-sm" @onclick="() => RemoveTrack(track)" title="Remove audio track">x</button>
            </div>
        }
    }

    @foreach (var lightTrack in _show.LightEventTracks)
    {
        var track = lightTrack;

        <LightEventTrackComponent Track="track"
                                  Duration="GetShowDuration()"
                                  Position="_playbackPosition"
                                  Devices="_devices"
                                  @bind-SelectedDeviceId="_selectedDeviceId"
                                  @bind-SelectedColor="_selectedColor"
                                  @bind-SelectedEvent="_selectedEvent"
                                  OnChanged="OnLightTrackChanged"
                                  OnRemove="() => RemoveTrack(track)" />
    }

    @if (_isProcessing)
    {
        <p>Analyzing audio file...</p>
    }
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ShowModel? _show;

    private const long MaxFileSize = 200 * 1024 * 1024;

    private bool _isProcessing;
    private string? _errorMessage;

    private readonly Dictionary<Guid, AudioTrackState> _trackStates = new();
    private int _regenerateVersion;
    private long _zoomVersion;

    private Guid? _playbackTrackId;
    private TimeSpan _playbackPosition;
    private bool _isPlaying;

    private System.Timers.Timer? _timer;

    private DotNetObjectReference<TimecodeShowDetail>? _dotNetRef;

    private List<Device> _devices = new();
    private Guid _selectedDeviceId;
    private Guid _selectedAudioFileId;
    private string _selectedColor = "#ffffff";
    private LightEvent? _selectedEvent;

    private const int BaseMaxWidth = 2000;

    private AudioTrackState GetState(Guid pTrackId)
    {
        if (!_trackStates.TryGetValue(pTrackId, out var state))
        {
            state = new AudioTrackState();
            state.DurationChanged += OnTrackDurationChanged;
            _trackStates[pTrackId] = state;
        }

        return state;
    }

    private void OnTrackDurationChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private TimeSpan GetShowDuration()
    {
        if (_show == null)
            return TimeSpan.Zero;

        TimeSpan duration = TimeSpan.Zero;

        foreach (var track in _show.AudioTracks)
        {
            var trackDuration = GetState(track.Id).Duration;

            if (trackDuration > duration)
                duration = trackDuration;
        }

        return duration;
    }

    private TimeSpan GetPosition(Guid pTrackId)
    {
        return pTrackId == _playbackTrackId ? _playbackPosition : GetState(pTrackId).Position;
    }

    private TimecodeAudioTrack? FindAudioTrack(Guid pTrackId)
    {
        return _show?.AudioTracks.FirstOrDefault(t => t.Id == pTrackId);
    }

    /// <summary>
    /// Recalculates the spectrograms in the background with a time resolution matching the current zoom level.
    /// </summary>
    private void RegenerateZoomImages(TimecodeAudioTrack pTrack)
    {
        var state = GetState(pTrack.Id);

        double targetZoom = Math.Clamp(Math.Pow(2, Math.Ceiling(Math.Log2(state.Zoom))), 1, 16);

        if (Math.Abs(targetZoom - state.RenderZoom) < 0.01)
            return;

        long version = Interlocked.Increment(ref _zoomVersion);

        _ = Task.Run(async () =>
        {
            await Task.Delay(250);

            if (version != _zoomVersion)
                return;

            try
            {
                var images = await Task.Run(() => CreateSpectrogramImages(pTrack, (int)(BaseMaxWidth * targetZoom)));

                if (version != _zoomVersion)
                    return;

                await InvokeAsync(() =>
                {
                    state.ImageDataUrls = images;
                    state.RenderZoom = targetZoom;
                    state.BaseWidth = (int)(BaseMaxWidth);
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = "Error processing file: " + ex.Message;
                    StateHasChanged();
                });
            }
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        _show = ShowService.GetShow(Id);

        if (_show == null)
            return;

        LightTrackService.SetShow(_show);

        RefreshDevices();

        foreach (var track in _show.AudioTracks)
        {
            if (track.AudioFiles.Any(f => f.File != null) && GetState(track.Id).ImageDataUrls.Count == 0)
            {
                try
                {
                    await GenerateImages(track);

                    PlaybackService.Load(track);
                    _playbackTrackId = track.Id;
                    GetState(track.Id).Duration = PlaybackService.Duration;
                    GetState(track.Id).ResetScale();
                    GetState(track.Id).Position = TimeSpan.Zero;
                }
                catch (Exception ex)
                {
                    _errorMessage = "Error processing file: " + ex.Message;
                }
            }
        }

        if (_timer == null)
        {
            _timer = new System.Timers.Timer(100);
            _timer.Elapsed += (_, _) => _ = InvokeAsync(UpdatePlaybackState);
            _timer.Start();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerSpaceToggle", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnKeyPressed(string pKey, bool pCtrlKey, bool pShiftKey, bool pAltKey)
    {
        var track = GetPlaybackTrack();

        if (track == null || track.AudioFiles.Count == 0)
            return;

        switch (pKey)
        {
            case "Space" when pCtrlKey:
                AddEventAtPlaybackPosition();
                break;
            case "Space":
                OnPlayPause(track);
                break;
        }

        StateHasChanged();
    }

    private TimecodeAudioTrack? GetPlaybackTrack()
    {
        if (_show == null)
            return null;

        if (_playbackTrackId != null)
        {
            var track = FindAudioTrack(_playbackTrackId.Value);

            if (track != null)
                return track;
        }

        return _show.AudioTracks.FirstOrDefault(t => t.AudioFiles.Any(f => f.File != null));
    }

    private void RefreshDevices()
    {
        _devices = DeviceService.Devices.ToList();

        if (_selectedDeviceId == Guid.Empty || _devices.All(d => d.Id != _selectedDeviceId))
        {
            _selectedDeviceId = _devices.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private void AddAudioTrack()
    {
        if (_show == null)
            return;

        _show.Tracks.Add(new TimecodeAudioTrack
        {
            Name = "Audio " + (_show.AudioTracks.Count() + 1)
        });
    }

    private void AddLightTrack()
    {
        if (_show == null)
            return;

        _show.Tracks.Add(new LightEventTrack
        {
            Name = "Lights " + (_show.LightEventTracks.Count() + 1)
        });

        LightTrackService.Reset();
    }

    private void RemoveTrack(ITimecodeShowTrack pTrack)
    {
        if (_show == null)
            return;

        if (pTrack is TimecodeAudioTrack audioTrack)
        {
            if (_playbackTrackId == audioTrack.Id)
            {
                PlaybackService.Stop();
                _playbackTrackId = null;
                _isPlaying = false;
            }

            foreach (var file in audioTrack.AudioFiles)
            {
                file.File?.Dispose();
            }

            _trackStates.Remove(audioTrack.Id);
        }
        else if (pTrack is LightEventTrack lightTrack)
        {
            if (_selectedEvent != null && lightTrack.Events.Any(e => e.Id == _selectedEvent.Id))
            {
                _selectedEvent = null;
            }
        }

        _show.Tracks.RemoveAll(t => t.Id == pTrack.Id);
        LightTrackService.Reset();
    }

    /// <summary>
    /// Adds an event at the current playback position to the first light track (keyboard shortcut).
    /// </summary>
    private void AddEventAtPlaybackPosition()
    {
        if (_show == null || _selectedDeviceId == Guid.Empty)
            return;

        var track = _show.LightEventTracks.FirstOrDefault();

        if (track == null)
        {
            track = new LightEventTrack { Name = "Lights 1" };
            _show.Tracks.Add(track);
        }

        var lightEvent = new LightEvent
        {
            DeviceId = _selectedDeviceId,
            Time = _playbackPosition,
            ColorHex = _selectedColor
        };

        track.Events.Add(lightEvent);
        _selectedEvent = lightEvent;
    }

    private void OnLightTrackChanged()
    {
        LightTrackService.Reset();
    }

    private void UpdatePlaybackState()
    {
        if (_playbackTrackId == null)
            return;

        _isPlaying = PlaybackService.IsPlaying;

        _playbackPosition = PlaybackService.Position;

        if (_isPlaying)
        {
            LightTrackService.UpdatePosition(_playbackPosition);
        }

        StateHasChanged();
    }

    private async Task GenerateImages(TimecodeAudioTrack pTrack)
    {
        var state = GetState(pTrack.Id);
        double renderZoom = state.RenderZoom;

        var images = await Task.Run(() => CreateSpectrogramImages(pTrack, (int)(BaseMaxWidth * renderZoom)));

        state.ImageDataUrls = images;
        state.BaseWidth = (int)BaseMaxWidth;
    }

    /// <summary>
    /// Creates one spectrogram image per audio file of the track. Files without a stream get a null entry.
    /// </summary>
    private List<string?> CreateSpectrogramImages(TimecodeAudioTrack pTrack, int pMaxWidth)
    {
        var images = new List<string?>();
        var durations = new List<TimeSpan>();

        foreach (var file in pTrack.AudioFiles)
        {
            if (file.File == null)
            {
                images.Add(null);
                durations.Add(TimeSpan.Zero);
                continue;
            }

            durations.Add(SpectrogramService.GetAudioDuration(file.File));

            var bmp = SpectrogramService.CreateSpectrogramBmp(file.File,
                pMaxWidth: pMaxWidth,
                pThreshold: pTrack.Threshold, pRatio: pTrack.Ratio, pBandwidth: pTrack.Bandwidth);

            images.Add("data:image/bmp;base64," + Convert.ToBase64String(bmp));
        }

        GetState(pTrack.Id).FileDurations = durations;

        return images;
    }

    private void RegenerateImages(TimecodeAudioTrack pTrack)
    {
        if (pTrack.AudioFiles.All(f => f.File == null))
            return;

        int version = Interlocked.Increment(ref _regenerateVersion);

        var state = GetState(pTrack.Id);

        _ = Task.Run(async () =>
        {
            await Task.Delay(150);

            if (version != _regenerateVersion)
                return;

            double renderZoom = state.RenderZoom;

            try
            {
                var images = await Task.Run(() => CreateSpectrogramImages(pTrack, (int)(BaseMaxWidth * renderZoom)));

                if (version != _regenerateVersion)
                    return;

                await InvokeAsync(() =>
                {
                    state.ImageDataUrls = images;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = "Error processing file: " + ex.Message;
                    StateHasChanged();
                });
            }
        });
    }

    private async Task OnFileSelected(InputFileChangeEventArgs pArgs)
    {
        _errorMessage = null;
        _isProcessing = true;

        PlaybackService.Stop();

        try
        {
            var audioStream = new MemoryStream();

            await pArgs.File.OpenReadStream(MaxFileSize).CopyToAsync(audioStream);

            audioStream.Position = 0;

            if (_show != null)
            {
                var track = _show.AudioTracks.FirstOrDefault();

                if (track == null)
                {
                    track = new TimecodeAudioTrack { Name = "Audio 1" };
                    _show.Tracks.Add(track);
                }

                track.AudioFiles.Add(new TimecodeAudioFile
                {
                    FileName = pArgs.File.Name,
                    File = audioStream,
                    StartOffset = GetState(track.Id).Duration
                });

                if (string.IsNullOrEmpty(track.Name))
                    track.Name = pArgs.File.Name;

                var state = GetState(track.Id);
                state.Position = TimeSpan.Zero;

                await GenerateImages(track);

                PlaybackService.Load(track);
                _playbackTrackId = track.Id;
                state.Duration = PlaybackService.Duration;
                _playbackPosition = TimeSpan.Zero;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Error processing file: " + ex.Message;
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void OnPlayPause(TimecodeAudioTrack pTrack)
    {
        if (PlaybackService.IsPlaying && _playbackTrackId == pTrack.Id)
        {
            PlaybackService.Pause();
        }
        else
        {
            if (_playbackTrackId != pTrack.Id && pTrack.AudioFiles.Any(f => f.File != null))
            {
                PlaybackService.Load(pTrack);
                _playbackTrackId = pTrack.Id;
                GetState(pTrack.Id).Duration = PlaybackService.Duration;
                _playbackPosition = GetState(pTrack.Id).Position;
                PlaybackService.Seek(_playbackPosition);
            }

            RefreshDevices();
            LightTrackService.Reset();
            PlaybackService.Play();
        }

        _isPlaying = PlaybackService.IsPlaying;
    }

    private void OnStop(TimecodeAudioTrack pTrack)
    {
        if (_playbackTrackId == pTrack.Id)
        {
            PlaybackService.Stop();
            _isPlaying = false;
            _playbackPosition = TimeSpan.Zero;
        }

        GetState(pTrack.Id).Position = TimeSpan.Zero;
        LightTrackService.Reset();
    }

    private void RemoveAudioFile(TimecodeAudioTrack pTrack, Guid pFileId)
    {
        var file = pTrack.AudioFiles.FirstOrDefault(f => f.Id == pFileId);

        if (file == null)
            return;

        pTrack.AudioFiles.Remove(file);
        file.File?.Dispose();

        _ = RefreshAudioTrack(pTrack);
    }

    private void MoveAudioFile(TimecodeAudioTrack pTrack, Guid pFileId, int pDirection)
    {
        int index = pTrack.AudioFiles.FindIndex(f => f.Id == pFileId);
        int newIndex = index + pDirection;

        if (index < 0 || newIndex < 0 || newIndex >= pTrack.AudioFiles.Count)
            return;

        (pTrack.AudioFiles[index], pTrack.AudioFiles[newIndex]) = (pTrack.AudioFiles[newIndex], pTrack.AudioFiles[index]);

        _ = RefreshAudioTrack(pTrack);
    }

    /// <summary>
    /// Recalculates file offsets and spectrograms and reloads playback after the files of a track changed.
    /// </summary>
    private async Task RefreshAudioTrack(TimecodeAudioTrack pTrack)
    {
        _errorMessage = null;

        try
        {
            var state = GetState(pTrack.Id);

            await GenerateImages(pTrack);

            if (_playbackTrackId == pTrack.Id)
            {
                var position = _playbackPosition;
                bool wasPlaying = PlaybackService.IsPlaying;

                PlaybackService.Load(pTrack);
                state.Duration = PlaybackService.Duration;
                state.ResetScale();

                PlaybackService.Seek(position);

                if (wasPlaying)
                    PlaybackService.Play();
            }
            else
            {
                var playlist = PlaylistWaveStream.Create(pTrack.AudioFiles.Where(f => f.File != null).Select(f => f.File!));

                if (playlist != null)
                {
                    state.Duration = playlist.TotalTime;
                    playlist.Dispose();
                }
                else
                {
                    state.Duration = TimeSpan.Zero;
                }

                state.ResetScale();
            }

            LightTrackService.Reset();
        }
        catch (Exception ex)
        {
            _errorMessage = "Error processing file: " + ex.Message;
        }

        StateHasChanged();
    }

    private void OnCursorDrag(TimecodeAudioTrack pTrack, AudioTrackComponent.CursorDragArgs pArgs)
    {
        var position = PositionFromOffset(pTrack.Id, pArgs.OffsetX);
        GetState(pTrack.Id).Position = position;

        if (pArgs.IsFinished && _playbackTrackId == pTrack.Id)
        {
            _playbackPosition = position;
            PlaybackService.Seek(position);
            LightTrackService.Reset();

            LightTrackService.UpdatePosition(position);
        }
    }

    /// <summary>
    /// Moves a single audio file on the time axis. Only the dragged file changes its offset,
    /// so breaks between the files can be created.
    /// </summary>
    private void OnFileDrag(TimecodeAudioTrack pTrack, AudioTrackComponent.FileDragArgs pArgs)
    {
        var file = pTrack.AudioFiles.FirstOrDefault(f => f.Id == pArgs.FileId);

        if (file == null)
            return;

        file.StartOffset = pArgs.NewStartOffset;

        // extend the track duration when the file is moved past the end
        var state = GetState(pTrack.Id);
        int fileIndex = pTrack.AudioFiles.IndexOf(file);
        var fileDuration = fileIndex >= 0 && fileIndex < state.FileDurations.Count
            ? state.FileDurations[fileIndex]
            : TimeSpan.Zero;
        var end = file.StartOffset + fileDuration;

        if (end > state.Duration)
            state.Duration = end;

        if (pArgs.IsFinished)
        {
            RefreshAudioTrackPlayback(pTrack);
        }
    }

    /// <summary>
    /// Reloads playback after the file offsets of a track changed (without regenerating spectrograms).
    /// </summary>
    private void RefreshAudioTrackPlayback(TimecodeAudioTrack pTrack)
    {
        if (_playbackTrackId != pTrack.Id)
            return;

        var position = _playbackPosition;
        bool wasPlaying = PlaybackService.IsPlaying;

        PlaybackService.Load(pTrack);

        PlaybackService.Seek(position);

        if (wasPlaying)
            PlaybackService.Play();

        LightTrackService.Reset();
    }

    private TimeSpan PositionFromOffset(Guid pTrackId, double pOffsetX)
    {
        var state = GetState(pTrackId);

        if (state.DisplayWidth <= 0)
            return TimeSpan.Zero;

        double fraction = Math.Clamp(pOffsetX / state.DisplayWidth, 0, 1);
        return TimeSpan.FromSeconds(fraction * state.Duration.TotalSeconds);
    }

    public void Dispose()
    {
        foreach (var state in _trackStates.Values)
        {
            state.DurationChanged -= OnTrackDurationChanged;
        }

        _timer?.Stop();
        _timer?.Dispose();

        _ = JSRuntime.InvokeVoidAsync("unregisterSpaceToggle");
        _dotNetRef?.Dispose();
    }
}
