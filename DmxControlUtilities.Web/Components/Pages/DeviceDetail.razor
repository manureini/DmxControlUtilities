@page "/devices/{Id:guid}"

@using DmxControlUtilities.Lib.Models
@using DmxControlUtilities.Lib.Models.Ddf
@using DmxControlUtilities.Lib.Services
@using DmxControlUtilities.Lib.Services.Hal
@using DmxControlUtilities.Web.Components.Devices

@inject DeviceService DeviceService
@inject HalService HalService
@inject NavigationManager NavigationManager

<PageTitle>Device</PageTitle>

@if (mDevice == null)
{
    <p>Device not found.</p>
}
else
{
    <h3>@mDevice.Name</h3>

    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" @bind="mDevice.Name" />
    </div>

    @if (mDescription == null)
    {
        <p>Device description "@mDevice.DescriptionId" not found.</p>
    }
    else
    {
        <div class="mb-3">
            <label class="form-label">Channel (1 - @(513 - mDescription.ChannelCount))</label>
            <input type="number" min="1" max="@(513 - mDescription.ChannelCount)" class="form-control" value="@mDevice.Channel" @onchange="OnChannelChanged" />
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Control</h5>

                @foreach (var feature in GetFeatures())
                {
                    <FeatureEditor Feature="feature" />
                }

                <button class="btn btn-outline-secondary btn-sm" @onclick="OnResetDefaults">Reset to defaults</button>
            </div>
        </div>
    }

    <button class="btn btn-secondary" @onclick="Back">Back</button>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    protected Device? mDevice;

    protected DeviceDescription? mDescription;

    protected override void OnParametersSet()
    {
        mDevice = DeviceService.GetDevice(Id);
        mDescription = mDevice != null ? DeviceService.GetDescription(mDevice) : null;
    }

    /// <summary>
    /// Returns the device's logical features.
    /// </summary>
    protected IEnumerable<HalFeature> GetFeatures()
    {
        if (mDevice == null)
            return Enumerable.Empty<HalFeature>();

        return HalService.GetFeatures(mDevice);
    }

    protected void OnChannelChanged(ChangeEventArgs pArgs)
    {
        if (mDevice == null || mDescription == null)
            return;

        if (int.TryParse(pArgs.Value?.ToString(), out var channel)
            && channel >= 1
            && channel + mDescription.ChannelCount - 1 <= 512)
        {
            mDevice.Channel = channel;
            DeviceService.ApplyDevice(mDevice);
        }
    }

    #region HAL control

    protected void OnResetDefaults()
    {
        if (mDevice == null)
            return;

        HalService.ResetToDefaults(mDevice);
    }

    #endregion

    protected void Back()
    {
        NavigationManager.NavigateTo("devices");
    }
}
