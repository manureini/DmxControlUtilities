@page "/spectrogram"

@implements IDisposable

@inject AudioSpectrogramService SpectrogramService
@inject AudioPlaybackService PlaybackService

<PageTitle>Spectrogram</PageTitle>

<h3>Audio Spectrogram</h3>

<InputFile OnChange="OnFileSelected" accept=".mp3,.wav,audio/*" />

@if (_errorMessage != null)
{
    <p style="color: red;">@_errorMessage</p>
}

@if (_imageDataUrl != null)
{
    <div style="margin-top: 1rem;">
        <p>@_fileName - X: time, Y: frequency (low frequencies at the bottom)</p>

        <div style="margin-bottom: 0.5rem;">
            <button class="btn btn-primary" @onclick="OnPlayPause" title="@(_isPlaying ? "Pause" : "Play")">
                @if (_isPlaying)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.125em;">
                        <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.125em;">
                        <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" />
                    </svg>
                }
            </button>
            <button class="btn btn-secondary" @onclick="OnStop" title="Stop">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" style="vertical-align: -0.125em;">
                    <path d="M5 3.5h6A1.5 1.5 0 0 1 12.5 5v6a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 11V5A1.5 1.5 0 0 1 5 3.5z" />
                </svg>
            </button>
            <span style="margin-left: 1rem;">@FormatTime(_position) / @FormatTime(_duration)</span>
        </div>

        <div style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="flex: 0 0 220px; border: 1px solid #ccc; border-radius: 6px; padding: 1rem;">
                <h6>Image Settings</h6>

                <label for="threshold" style="display: block; margin-top: 0.5rem;">Threshold: @_threshold.ToString("0.00")</label>
                <input id="threshold" type="range" min="0" max="0.9" step="0.01" style="width: 100%;"
                       @bind="_threshold" @bind:event="oninput" @bind:after="RegenerateImage" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>0</span><span>0.9</span></div>

                <label for="ratio" style="display: block; margin-top: 0.5rem;">Ratio: @_ratio.ToString("0.00")</label>
                <input id="ratio" type="range" min="0.25" max="4" step="0.05" style="width: 100%;"
                       @bind="_ratio" @bind:event="oninput" @bind:after="RegenerateImage" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>0.25</span><span>4</span></div>

                <label for="bandwidth" style="display: block; margin-top: 0.5rem;">Bandwidth: @_bandwidth.ToString("0.00")</label>
                <input id="bandwidth" type="range" min="1" max="3" step="0.05" style="width: 100%;"
                       @bind="_bandwidth" @bind:event="oninput" @bind:after="RegenerateImage" @bind:culture="System.Globalization.CultureInfo.InvariantCulture" />
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #888;"><span>1</span><span>3</span></div>
            </div>

            <div style="overflow-x: auto; flex: 1 1 auto; min-width: 0;">
                <div style="position: relative; width: @(_imageWidth)px; height: 512px; cursor: crosshair; user-select: none;"
                     @onmousedown="OnCursorMouseDown"
                     @onmousemove="OnCursorMouseMove"
                     @onmouseup="OnCursorMouseUp"
                     @onmouseleave="OnCursorMouseUp">
                    <img src="@_imageDataUrl"
                         style="width: @(_imageWidth)px; height: 512px; display: block; pointer-events: none;"
                         draggable="false"
                         alt="Spectrogram" />
                    <div style="position: absolute; top: 0; bottom: 0; left: @(CursorX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px; width: 2px; background-color: red; pointer-events: none;"></div>
                </div>
            </div>
        </div>
    </div>
}

@if (_isProcessing)
{
    <p>Analyzing audio file...</p>
}

@code {

    private const long MaxFileSize = 200 * 1024 * 1024;

    private bool _isProcessing;
    private string? _errorMessage;
    private string? _imageDataUrl;
    private string? _fileName;

    private double _threshold = 0;
    private double _ratio = 1;
    private double _bandwidth = 2;
    private int _regenerateVersion;
    private string? _tempFile;

    private int _imageWidth;
    private bool _isPlaying;
    private bool _isDragging;

    private TimeSpan _duration;
    private TimeSpan _position;

    private System.Timers.Timer? _timer;

    private double CursorX => _duration > TimeSpan.Zero
        ? _position.TotalSeconds / _duration.TotalSeconds * _imageWidth
        : 0;

    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(100);
        _timer.Elapsed += (_, _) => _ = InvokeAsync(UpdatePlaybackState);
        _timer.Start();
    }

    private void UpdatePlaybackState()
    {
        if (_imageDataUrl == null)
            return;

        _isPlaying = PlaybackService.IsPlaying;

        if (!_isDragging)
        {
            _position = PlaybackService.Position;
        }

        StateHasChanged();
    }

    private async Task GenerateImage()
    {
        if (_tempFile == null)
            return;

        var bmp = await Task.Run(() => SpectrogramService.CreateSpectrogramBmp(_tempFile,
            pThreshold: _threshold, pRatio: _ratio, pBandwidth: _bandwidth));

        _imageWidth = BitConverter.ToInt32(bmp, 18);
        _imageDataUrl = "data:image/bmp;base64," + Convert.ToBase64String(bmp);
    }

    private void RegenerateImage()
    {
        if (_tempFile == null)
            return;

        int version = Interlocked.Increment(ref _regenerateVersion);

        _ = Task.Run(async () =>
        {
            await Task.Delay(150);

            if (version != _regenerateVersion)
                return;

            string tempFile = _tempFile;
            double threshold = _threshold;
            double ratio = _ratio;
            double bandwidth = _bandwidth;

            try
            {
                var bmp = SpectrogramService.CreateSpectrogramBmp(tempFile,
                    pThreshold: threshold, pRatio: ratio, pBandwidth: bandwidth);

                if (version != _regenerateVersion)
                    return;

                await InvokeAsync(() =>
                {
                    _imageWidth = BitConverter.ToInt32(bmp, 18);
                    _imageDataUrl = "data:image/bmp;base64," + Convert.ToBase64String(bmp);
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = "Error processing file: " + ex.Message;
                    StateHasChanged();
                });
            }
        });
    }

    private async Task OnFileSelected(InputFileChangeEventArgs pArgs)
    {
        _errorMessage = null;
        _imageDataUrl = null;
        _isProcessing = true;
        _fileName = pArgs.File.Name;

        PlaybackService.Stop();
        DeleteTempFile();

        _tempFile = Path.Combine(Path.GetTempPath(), Path.GetRandomFileName() + Path.GetExtension(pArgs.File.Name));

        try
        {
            await using (var fileStream = File.Create(_tempFile))
            {
                await pArgs.File.OpenReadStream(MaxFileSize).CopyToAsync(fileStream);
            }

            await GenerateImage();

            PlaybackService.Load(_tempFile);
            _duration = PlaybackService.Duration;
            _position = TimeSpan.Zero;
        }
        catch (Exception ex)
        {
            _errorMessage = "Error processing file: " + ex.Message;
            DeleteTempFile();
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void OnPlayPause()
    {
        if (PlaybackService.IsPlaying)
        {
            PlaybackService.Pause();
        }
        else
        {
            PlaybackService.Play();
        }

        _isPlaying = PlaybackService.IsPlaying;
    }

    private void OnStop()
    {
        PlaybackService.Stop();
        _isPlaying = false;
        _position = TimeSpan.Zero;
    }

    private void OnCursorMouseDown(MouseEventArgs pArgs)
    {
        _isDragging = true;
        _position = PositionFromOffset(pArgs.OffsetX);
    }

    private void OnCursorMouseMove(MouseEventArgs pArgs)
    {
        if (!_isDragging)
            return;

        _position = PositionFromOffset(pArgs.OffsetX);
    }

    private void OnCursorMouseUp(MouseEventArgs pArgs)
    {
        if (!_isDragging)
            return;

        _isDragging = false;
        _position = PositionFromOffset(pArgs.OffsetX);
        PlaybackService.Seek(_position);
    }

    private TimeSpan PositionFromOffset(double pOffsetX)
    {
        if (_imageWidth <= 0)
            return TimeSpan.Zero;

        double fraction = Math.Clamp(pOffsetX / _imageWidth, 0, 1);
        return TimeSpan.FromSeconds(fraction * _duration.TotalSeconds);
    }

    private static string FormatTime(TimeSpan pTime)
    {
        return pTime.ToString(@"mm\:ss\.f");
    }

    private void DeleteTempFile()
    {
        if (_tempFile != null && File.Exists(_tempFile))
        {
            try
            {
                File.Delete(_tempFile);
            }
            catch (IOException)
            {
                // file may still be in use by playback
            }
        }
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
