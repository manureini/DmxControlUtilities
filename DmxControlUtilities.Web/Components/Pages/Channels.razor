@page "/channels"

@using DmxControlUtilities.Lib.Services

@inject DmxFtdiService DmxService
@inject DeviceService DeviceService
@implements IDisposable

<PageTitle>Channels</PageTitle>

<h3>DMX Channels</h3>

<div class="channel-grid">
    @for (int i = 1; i <= 512; i++)
    {
        var channel = i;

        <div class="channel-box">
            <div class="channel-header">@channel</div>

            <input type="range"
                   min="0"
                   max="255"
                   step="1"
                   value="@mValues[channel]"
                   @oninput="e => OnValueChanged(channel, e)" />

            <div class="channel-value">@mValues[channel]</div>

            @if (GetUsage(channel) is var usage && usage != null)
            {
                <div class="channel-usage" title="@usage.Value.DeviceName">
                    <span class="channel-device">@usage.Value.DeviceName</span>
                    <span class="channel-function">@usage.Value.FunctionName</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .channel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
        gap: 6px;
    }

    .channel-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 4px;
    }

    .channel-header {
        font-size: 0.75rem;
        color: #666;
    }

    .channel-box input[type=range] {
        width: 100%;
    }

    .channel-value {
        font-weight: bold;
    }

    .channel-usage {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 2px;
        width: 100%;
        overflow: hidden;
    }

    .channel-device,
    .channel-function {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.1;
    }

    .channel-device {
        font-size: 0.68rem;
        font-weight: 600;
        color: #0d6efd;
    }

    .channel-function {
        font-size: 0.68rem;
        color: #666;
    }
</style>

@code {

    protected byte[] mValues = new byte[513];

    private Dictionary<int, (string DeviceName, string FunctionName)>? mUsage;

    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        BuildUsageMap();
        RefreshValues();

        _timer = new System.Timers.Timer(500);
        _timer.Elapsed += (_, _) => _ = InvokeAsync(() =>
        {
            RefreshValues();
            StateHasChanged();
        });
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void RefreshValues()
    {
        for (int i = 1; i <= 512; i++)
        {
            mValues[i] = DmxService.GetChannel(i);
        }
    }

    protected void OnValueChanged(int pChannel, ChangeEventArgs pArgs)
    {
        if (!byte.TryParse(pArgs.Value?.ToString(), out var value))
            return;

        mValues[pChannel] = value;
        DmxService.SetChannel(pChannel, value);
    }

    private (string DeviceName, string FunctionName)? GetUsage(int pChannel)
    {
        return mUsage != null && mUsage.TryGetValue(pChannel, out var usage) ? usage : null;
    }

    /// <summary>
    /// Maps each absolute DMX channel to the device and function occupying it.
    /// </summary>
    private void BuildUsageMap()
    {
        var map = new Dictionary<int, (string, string)>();

        foreach (var device in DeviceService.Devices)
        {
            var description = DeviceService.GetDescription(device);

            if (description == null)
                continue;

            foreach (var function in description.Functions)
            {
                int channel = device.Channel + function.DmxChannel;

                if (channel >= 1 && channel <= 512)
                    map[channel] = (device.Name, function.Name);
            }
        }

        mUsage = map;
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}
